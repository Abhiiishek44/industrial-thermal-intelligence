#  Flask Backend
#  Flask Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wildfire_db
DB_USER=postgres
DB_PASSWORD=change-me-strong-password

# Managed platforms start the app and database independently. These defaults
# allow the app to wait briefly for PostGIS to become reachable.
DB_STARTUP_MAX_ATTEMPTS=12
DB_STARTUP_RETRY_SECONDS=5

#  PostgreSQL Container (must match DB_* above)
POSTGRES_DB=wildfire_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ── Authentication ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-random-64-chars
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
# The admin is created on first startup when ADMIN_PASSWORD is non-empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy


# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "claude" (default), "gemini", or "huggingface"
LLM_PROVIDER=claude
# CLAUDE_MODEL=claude-sonnet-4-6      # optional, this is the default
# GEMINI_MODEL=gemini-2.0-flash       # optional, this is the default
# HF_MODEL=deepseek-ai/DeepSeek-V4-Flash  # optional, this is the default

# Anthropic API — get yours at https://platform.claude.com/docs/en/api/admin/api_keys/retrieve
# WARNING: This key is tied to a paid account. Every API call incurs a cost.
#   - Do NOT commit your real key to any public or shared repository.
#   - Do NOT share this key with others.
#   - Set a monthly spend limit at https://console.anthropic.com/settings/limits
#     to prevent unexpected charges if the key is leaked or abused.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gemini API — get yours at https://aistudio.google.com/api-keys
# WARNING: If upgraded to a paid tier, leaking this key can incur charges.
#   - Do NOT commit your real key to any public or shared repository.
#   - Set API restrictions at https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_gemini_api_key

# Hugging Face Inference Providers — create a fine-grained token with
# "Make calls to Inference Providers" permission at https://huggingface.co/settings/tokens
# WARNING: Do NOT commit your real token to any public or shared repository.
HF_TOKEN=your_huggingface_token

# ── Data Sources ──────────────────────────────────────────────────────────────
ACTIVE_REGION=vijayanagar
# Use "all" for the complete India catalog, or a comma-separated subset such
# as vijayanagar,talcher_angul,gadchiroli_tadoba when API quota is limited.
AUTO_PREPARE_REGIONS=all

# FIRMS Map Key — get yours at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Limit: 5000 transactions / 10 minutes (larger requests count as multiple)
FIRMS_API_KEY=your_firms_api_key

# Historical thermal-monitoring collection runs in idempotent 1-5 day chunks.
# Set to 0 to normalize only already-cached FIRMS CSV files during startup.
FIRMS_HISTORY_AUTO_FETCH=1

# Near-real-time regional refresh. The backend fetches the latest FIRMS data,
# rebuilds derived thermal artifacts and advances the dashboard automatically.
THERMAL_AUTO_REFRESH=1
THERMAL_REFRESH_INTERVAL_HOURS=4
# Retry sooner after a transient NASA FIRMS/network failure instead of waiting
# for the full scheduled interval.
THERMAL_FAILURE_RETRY_MINUTES=15
# Fetch two days each cycle so late-arriving observations around UTC midnight
# are not missed. NASA FIRMS Area API accepts 1-5 days.
THERMAL_LIVE_LOOKBACK_DAYS=2

# Derived thermal analytics. Tune against each active region without code changes.
THERMAL_DEDUP_RADIUS_M=500
THERMAL_DEDUP_TIME_MINUTES=90
THERMAL_CLUSTER_RADIUS_M=300
THERMAL_CLUSTER_MIN_OBSERVATIONS=2

# Optional India population override. The default local source is the official
# WorldPop India 2026 constrained 1 km grid, sized for the 1/3/5 km exposure
# bands. Point this variable to the larger 100 m grid when finer detail is needed.
# The 1 km source is downloaded automatically on first startup (~16 MB).
WORLDPOP_AUTO_DOWNLOAD=1
# WORLDPOP_RASTER_PATH=/absolute/path/ind_pop_2026_CN_100m_R2025A_v1.tif

# Copernicus CDS Personal Access Token — get yours at https://cds.climate.copernicus.eu/profile
# Required for ERA5-Land weather data download
CDS_KEY=your_cds_key

# NASA Earthdata Bearer Token — get yours at https://urs.earthdata.nasa.gov/profile
# Required for VIIRS cloud mask download (optional — cloud masking disabled if not set)
EARTHDATA_TOKEN=your_earthdata_token
